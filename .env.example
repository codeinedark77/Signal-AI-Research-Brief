# Copy this to .env and fill in real values. Never commit the real .env.

# --- signal-api ---
# Required for real scoring/summarization. Leave SIGNAL_USE_FAKE_LLM=1 (below)
# to dry-run without one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional but recommended: raises GitHub Search API's rate limit from 10/min
# (unauthenticated) to 30/min. Create at https://github.com/settings/tokens
# with no scopes selected (public search needs none).
GITHUB_TOKEN=

# Set to 1 to use the deterministic FakeLLMClient instead of a real model --
# useful for a dry run of the whole pipeline with zero API cost/setup.
SIGNAL_USE_FAKE_LLM=0

# --- n8n ---
# Chat id to send the daily brief to. Message @userinfobot on Telegram to
# get your own numeric chat id.
TELEGRAM_CHAT_ID=

# Timezone for n8n's schedule trigger and any date formatting.
TZ=Asia/Kolkata
